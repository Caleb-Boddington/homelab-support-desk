#!/usr/bin/env python3
# CT 111: /usr/local/bin/support-triage EVENT.json.
#
# Started by support-listener for every Uptime Kuma event. On a "down" it wakes Claude
# (headless, `claude -p`) to investigate through the support gate, then sends the owner ONE message
# with the findings. On an "up" it sends the all-clear, unless Claude already said it was fixed.
#
# Claude's power here is limited by the key, not by the prompt: it can only run
# `support-ask ...` (a fixed wrapper round `ssh support`), and the host lets that key run nothing but the support-gate menu.
#
# Hardened after the security review of 28/09/2026:
# - B3: Kuma's message and the logs Claude reads can carry text written by anyone who can make an
#   app log a line, so they are treated as untrusted. The message is flattened to one line, cut
#   short and fenced in the prompt, and the prompt tells Claude never to obey it. Claude's answer
#   is cleaned before it reaches the owner's phone: no links, no control characters, short fields.
# - B4: a fake alert with a new monitor name each time would wake Claude every time, so Claude is
#   woken at most MAX_CLAUDE_PER_HOUR times an hour. Later faults still get a plain message.
# - B7: log lines have their control characters escaped, so a message cannot forge a log line.
# Security review of 13/10/2026:
# - C4: after a green that Kuma has not yet confirmed with an "up", this process waits
#   RECHECK_AFTER and sends a red if the "up" still hasn't come (see recheck()).
# - C7(c), left as it is on purpose: one lock for every monitor means a long run delays the
#   others. A lock per monitor would let several Claude runs share CT 111's memory at once (the
#   25/09/2026 thrash) and lets two investigations restart things in parallel.
import fcntl
import json
import os
import re
import subprocess
import sys
import time

HOME = "/opt/support-desk"
STATE = "/var/lib/support-desk"
LOG = "/var/log/support-desk.log"
LOCK = "/run/support-triage.lock"
PROMPT = f"{HOME}/triage-prompt.md"
MAX_CLAUDE_PER_HOUR = 6
RECHECK_AFTER = 8 * 60   # C4: how long after a green, with no "up" from Kuma, before a red follows
MAX_MSG, MAX_FIELD = 300, 200

CONTROL = re.compile(r"[\x00-\x1f\x7f\x85  ]")
LINK = re.compile(r"(?i)\b(?:https?://|ftp://|www\.)\S+")

# Kuma monitor name -> (service emoji key, name the owner knows, "down" title, "up" title,
#                       what it means when down, where Claude should start)
MONITORS = {
    "AdGuard (house DNS)": ("adguard", "AdGuard", "AdGuard is down", "AdGuard is back",
                            "Websites may not load anywhere in the house.", "container 101"),
    "Jellyfin": ("jellyfin", "Jellyfin", "Jellyfin is down", "Jellyfin is back",
                 "Films and TV won't play.", "container 102, service jellyfin"),
    "Homepage dashboard": ("dashboard", "The dashboard", "The dashboard is down", "The dashboard is back",
                           "The server dashboard won't load.", "container 103, Docker app dashboard"),
    "Immich (photos)": ("immich", "Immich", "Immich is down", "Immich is back",
                        "Photos won't load or back up from your phone.", "container 105, Docker apps immich_*"),
    "Forgejo": ("forgejo", "Forgejo", "Forgejo is down", "Forgejo is back",
                "Your code store can't be reached.", "container 107"),
    "Home Assistant": ("homeassistant", "Home Assistant", "Home Assistant is down", "Home Assistant is back",
                       "Smart home controls won't work.", "VM 200"),
    "Proxmox": ("server", "The server's control panel", "The server's control panel is down",
                "The server's control panel is back", "The Proxmox web page won't load.", "the host itself"),
    "Hub file share": ("hub", "File sharing", "File sharing is down", "File sharing is back",
                       "Your PC and Mac can't reach the hub.", "the host's Samba service"),
    "Internet connection": ("internet", "The internet", "The house internet is down",
                            "The house internet is back", "Nothing online will work.", "the house broadband"),
    "Nightly backup ran": ("backup", "The backup", "Last night's backup didn't finish",
                           "Backups are working again", "Your files weren't backed up last night.",
                           "the backup log in facts"),
}


def escape(text):
    """Control characters as visible \\xNN, so one log call is always one log line."""
    return CONTROL.sub(lambda m: f"\\x{ord(m.group()):02x}", str(text))


def flatten(text, limit):
    """Control characters to spaces, whitespace squeezed, cut to `limit` characters."""
    return re.sub(r"\s+", " ", CONTROL.sub(" ", str(text))).strip()[:limit]


def untrusted(text, limit):
    """Text from Kuma or an app, made safe to quote inside the prompt's fence."""
    return flatten(text, limit).replace("<", "(").replace(">", ")")


def clean_field(text):
    """One field of Claude's answer, made safe to put on the owner's phone."""
    return LINK.sub("(link removed)", flatten(text if isinstance(text, str) else "", MAX_FIELD))


def log(msg):
    with open(LOG, "a") as f:
        f.write(f"{time.strftime('%F %T')}  triage: {escape(msg)}\n")


def claude_allowed():
    """True, and the run is counted, if Claude has been woken fewer than the cap this hour."""
    path = os.path.join(STATE, "claude-runs.json")
    now = time.time()
    runs = [t for t in load(path).get("runs", []) if isinstance(t, (int, float)) and now - t < 3600]
    if len(runs) >= MAX_CLAUDE_PER_HOUR:
        return False
    save(path, {"runs": runs + [now]})
    return True


def fill_prompt(template, values):
    """Fill {monitor}, {msg}, {time} and {hint} in one pass, so text inside one value can never
    be taken for another placeholder."""
    return re.sub(r"\{(monitor|msg|time|hint)\}", lambda m: values[m.group(1)], template)


def notify(level, service, title, lines, you=None):
    cmd = ["server-notify", level, service, title] + [l for l in lines if l]
    if you:
        cmd += ["--you", you]
    subprocess.run(cmd, timeout=90)


def state_path(monitor):
    return os.path.join(STATE, "state-" + re.sub(r"[^a-z0-9]+", "-", monitor.lower()).strip("-") + ".json")


def load(path):
    try:
        return json.load(open(path))
    except Exception:
        return {}


def save(path, data):
    json.dump(data, open(path, "w"))


def ask_claude(monitor, msg, when, hint):
    prompt = fill_prompt(open(PROMPT).read(), {
        "monitor": untrusted(monitor, 100), "msg": untrusted(msg, MAX_MSG) or "no detail",
        "time": when, "hint": hint})
    try:
        p = subprocess.run(
            ["claude", "-p", prompt, "--output-format", "json", "--tools", "Bash",
             "--allowedTools", "Bash(support-ask:*)", "--permission-mode", "default"],
            cwd=HOME, capture_output=True, text=True, timeout=540,
            env={**os.environ, "HOME": "/root"})
    except subprocess.TimeoutExpired:
        return None, "timed out"
    try:
        out = json.loads(p.stdout)
        text = out.get("result", "")
        if out.get("is_error"):
            return None, "error: " + text[:200]
    except Exception:
        return None, f"exit {p.returncode}: {(p.stderr or p.stdout)[-300:]}"
    m = re.search(r"\{.*\}", text, re.S)
    try:
        answer = json.loads(m.group(0))
        if not isinstance(answer, dict):
            raise ValueError
    except Exception:
        return None, "unreadable answer: " + text[-300:]
    return clean_answer(answer), None


def clean_answer(answer):
    """Only the expected fields, with the text ones cleaned and the flags forced to booleans."""
    out = {k: clean_field(answer.get(k)) for k in ("what_it_means", "cause", "what_was_done", "needs_you")}
    out.update({k: answer.get(k) is True for k in ("fixed", "recovered_on_its_own")})
    return out


def main(event_file):
    ev = json.load(open(event_file))
    monitor, status, msg = flatten(ev["monitor"], 100), ev["status"], flatten(ev.get("msg", ""), MAX_MSG)
    svc, name, down_t, up_t, meaning, hint = MONITORS.get(
        monitor, ("server", monitor, f"{monitor} is down", f"{monitor} is back",
                  "Something on the server isn't working.", "unknown, start with facts"))
    sp = state_path(monitor)
    os.makedirs(STATE, exist_ok=True)

    if status == 1:  # up
        st = load(sp)
        if st.get("investigating"):
            st["recovered_during"] = True
            save(sp, st)
        elif st.get("reported") == "red":
            mins = int((time.time() - st.get("at", time.time())) / 60)
            notify("green", svc, up_t, ["It's working again." + (f" It was down for about {mins} minutes." if mins >= 2 else "")])
            os.remove(sp)
        elif os.path.exists(sp):
            os.remove(sp)  # Claude already said it was fixed; stay quiet
        log(f"up {monitor}")
        return

    # down: one investigation at a time, and one per outage
    with open(LOCK, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        st = load(sp)
        # A fix Claude reported is only held for 20 minutes: if Kuma never saw the outage it
        # never sends the "up" that would clear it, and the next real fault must not be ignored.
        hold = 20 * 60 if st.get("reported") == "green" else 6 * 3600
        if (st.get("reported") or st.get("investigating")) and time.time() - st.get("at", 0) < hold:
            log(f"down {monitor} already handled")
            return
        started = time.time()
        save(sp, {"investigating": True, "at": started})
        log(f"down {monitor}: {msg}")
        if claude_allowed():
            answer, err = ask_claude(monitor, msg, time.strftime("%H:%M on %d/%m"), hint)
            why = "🤖 Claude couldn't investigate this time."
        else:
            answer, err = None, f"not woken: {MAX_CLAUDE_PER_HOUR} runs in the last hour already"
            why = f"🤖 Claude has already looked at {MAX_CLAUDE_PER_HOUR} problems in the last hour, so it didn't look at this one."
        st = load(sp)
        recovered = st.get("recovered_during", False)

        if answer is None:
            log(f"claude failed for {monitor}: {err}")
            if recovered:
                notify("green", svc, up_t, ["It went down briefly and came back on its own."])
                os.remove(sp)
            else:
                notify("red", svc, down_t, [meaning, why],
                       "Ask Claude on home-server to look into it.")
                save(sp, {"reported": "red", "at": started})
            return

        log(f"claude answered for {monitor}: {json.dumps(answer)}")
        cause, done, you = answer.get("cause", ""), answer.get("what_was_done", ""), answer.get("needs_you", "")
        if answer.get("fixed"):
            notify("green", svc, up_t, [cause, done], you or None)
            if recovered:
                os.remove(sp)
            else:
                save(sp, {"reported": "green", "at": started})
                return (monitor, svc, down_t, meaning, started, "Claude thought it had fixed this")
        elif answer.get("recovered_on_its_own") or recovered:
            notify("green", svc, up_t, ["It went down briefly and came back on its own.", cause], you or None)
            if recovered:
                os.remove(sp)
            else:
                save(sp, {"reported": "green", "at": started})
                return (monitor, svc, down_t, meaning, started, "Claude thought this had come back on its own")
        else:
            notify("red", svc, down_t, [answer.get("what_it_means") or meaning, cause, done],
                   you or "Ask Claude on home-server to look into it.")
            save(sp, {"reported": "red", "at": started})


def wait(seconds):
    time.sleep(seconds)


def recheck(monitor, svc, down_t, meaning, started, thought):
    """C4, security review 13/10/2026. A green sent before Kuma has seen the service come back
    makes the later "up" silent. Kuma sends one "down" per outage, so if Claude was wrong the
    outage would stay silent for good. Kuma's "up" deletes the state file; if, RECHECK_AFTER later,
    the file still holds this same green, Kuma has not seen it come back, so send a red. Saving the
    red first means the eventual "up" sends the normal all-clear."""
    wait(RECHECK_AFTER)
    sp = state_path(monitor)
    st = load(sp)
    if st.get("reported") != "green" or st.get("at") != started:
        log(f"recheck {monitor}: back up, or handled since")
        return
    save(sp, {"reported": "red", "at": started})
    mins = RECHECK_AFTER // 60
    log(f"recheck {monitor}: no up from Kuma {mins} minutes after a green, sending red")
    notify("red", svc, down_t, [f"🤖 {thought}, but it's still down: Uptime Kuma hasn't seen it come "
                                f"back in the {mins} minutes since.", meaning],
           "Ask Claude on home-server to look into it.")


def run(event_file):
    """One event. The event file is removed before any recheck wait, so a waiting recheck does not
    count against the listener's limit of events waiting for triage. The wait runs in this process
    (the listener starts one per event and never waits for it), after the lock is let go, so it
    holds up nothing else."""
    pending = None
    try:
        pending = main(event_file)
    except Exception as e:
        log(f"CRASHED on {event_file}: {e!r}")
        raise
    finally:
        try:
            os.remove(event_file)
        except OSError:
            pass
    if pending:
        try:
            recheck(*pending)
        except Exception as e:
            log(f"CRASHED rechecking {pending[0]}: {e!r}")
            raise


if __name__ == "__main__":
    run(sys.argv[1])
