#!/usr/bin/env python3
# The one way anything on the home server sends the owner a notification. Installed on the host,
# and in each container that sends alerts, as /usr/local/bin/server-notify.
#
#   server-notify LEVEL SERVICE "Title" ["line" ...] [--you "what the owner needs to do"]
#
# LEVEL is red, amber, green or brake. SERVICE picks the emoji at the end of the title.
# Style chosen by the owner on 23/09/2026: traffic light first, service emoji last, a blank line
# between every section. If everything is fine, nothing is sent at all.
import json
import sys
import time
import urllib.request

TOPIC_FILE = "/root/ntfy-topic.txt"
LOG = "/var/log/server-notify.log"

LIGHTS = {"red": ("🔴", 4), "amber": ("🟠", 3), "green": ("🟢", 3), "brake": ("🛑", 5)}

EMOJI = {
    "jellyfin": "🎬", "immich": "📸",
    "backup": "💾", "disk": "💽", "adguard": "🛡️", "forgejo": "🗃️",
    "hub": "📁", "tailscale": "🌐", "internet": "📶", "monitor": "📈", "dashboard": "🖥️",
    "homeassistant": "💡", "server": "🏠", "claude": "🤖", "docker": "🐳",
    "scan": "🦠",
}


def main(argv):
    if len(argv) < 3 or argv[0] not in LIGHTS:
        print(__doc__ or "usage: server-notify red|amber|green|brake SERVICE TITLE [LINE ...] [--you TEXT]",
              file=sys.stderr)
        return 2
    level, service, title, rest = argv[0], argv[1], argv[2], argv[3:]
    you = None
    if "--you" in rest:
        i = rest.index("--you")
        you = " ".join(rest[i + 1:]).strip() or None
        rest = rest[:i]
    light, priority = LIGHTS[level]
    lines = [line.strip() for line in rest if line.strip()]
    if you:
        lines.append("👉 " + you)
    body = {
        "title": f"{light} {title} {EMOJI.get(service, '🏠')}",
        "message": "\n\n".join(lines) or title,
        "priority": priority,
    }
    try:
        body["topic"] = open(TOPIC_FILE).read().strip()
    except OSError:
        return 1
    data = json.dumps(body).encode()
    ok = False
    for attempt in range(3):
        try:
            req = urllib.request.Request("https://ntfy.sh/", data=data,
                                         headers={"Content-Type": "application/json"})
            ok = urllib.request.urlopen(req, timeout=10).status == 200
            if ok:
                break
        except Exception:
            pass
        time.sleep(5 * (attempt + 1))
    try:
        with open(LOG, "a") as f:
            f.write(f"{time.strftime('%F %T')}  {'sent' if ok else 'FAILED'}  {body['title']}\n")
    except OSError:
        pass
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
